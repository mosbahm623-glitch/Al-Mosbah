{
  "name": "legacy-erp",
  "private": true,
  "version": "1.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:live": "playwright test -c playwright.live.config.ts",
    "preview": "vite preview",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"*.{ts,json}\" \"e2e/*.ts\" \"e2e-live/*.ts\" \"scripts/*.mjs\" \".github/**/*.yml\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"*.{ts,json}\" \"e2e/*.ts\" \"e2e-live/*.ts\" \"scripts/*.mjs\" \".github/**/*.yml\"",
    "architecture:check": "node scripts/check-architecture.mjs",
    "knip": "knip",
    "quality": "npm run format:check && npm run lint && npm run architecture:check && npm run knip && npm test && npm run build"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.2",
    "exceljs": "^4.4.0",
    "lucide-react": "^1.79.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.7",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.1",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^31.0.1",
    "knip": "^6.48.0",
    "oxlint": "^1.95.0",
    "pg": "^8.23.1",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.1"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
